# Fig: orchestrator-owned invariant-checker routing (academic monochrome)
# render: d2 --theme=0 --pad=8 checker-routing.d2 ../checker-routing.svg

classes: {
  state: { style: { fill: white; stroke: "#7A7A7A"; stroke-width: 1; font-color: "#333333" } }
  key:   { style: { fill: "#E3E3E3"; stroke: "#1A1A1A"; stroke-width: 2; font-color: "#1A1A1A" } }
  node:  { style: { fill: white; stroke: "#1A1A1A"; stroke-width: 1; font-color: "#1A1A1A" } }
  note:  { style: { fill: white; stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#333333" } }
}

direction: down

queue: "Orchestrator target queue\n(INV-A, Checkers A) · (INV-B, Checkers B) · …" { class: state }
meta: "Checker-metadata SSOT\nISA-to-checker map · mode · cost" { class: state }
lock: "Locked directed task\none invariant + checker suite\n+ applicable ISAs + budget" { class: key }
gen: "Generator agent\nconstruct seed for the assigned invariant\n(no checker or ISA selection)" { class: node }
routing: "Deterministic routing\nseed × (ISA, checker) mapping" { class: node }
x86: "INV-A: Checker A_x86\nx86-64" { class: node }
arm: "INV-A: Checker A_arm\nAArch64" { class: node }
rv: "INV-A: Checker A_rv\nRISC-V" { class: node }
rule: "Differential test: all mapped checkers are required" { class: note }

queue -> lock: "fixed cursor" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
meta -> lock: "metadata lookup" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
lock -> gen: "assign invariant" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
lock -> routing: "fix suite + ISAs" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
gen -> routing: "seed only" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
routing -> x86: "fan-out" { style: { stroke: "#1A1A1A"; stroke-width: 1; font-color: "#555555" } }
routing -> arm: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
routing -> rv: "" { style: { stroke: "#1A1A1A"; stroke-width: 1 } }
routing -> rule: "constraint" { style: { stroke: "#7A7A7A"; stroke-width: 1; stroke-dash: 4; font-color: "#555555" } }
